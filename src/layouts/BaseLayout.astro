---
/**
 * Layout base del sitio. Define el <head> con SEO y envuelve el contenido.
 */
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#191A33" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;700&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} canonical={canonical} />
  </head>
  <body class="bg-brand-950 text-brand-100 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-brand-950"
    >
      Saltar al contenido
    </a>
    <SiteHeader />
    <slot />
    <footer class="h-[259px] overflow-hidden bg-[#0a0e19] py-10 text-brand-100 md:h-auto">
      <div class="ak-container flex h-[179px] flex-col items-start justify-between md:h-auto md:flex-row md:items-end">
        <a class="ak-focus relative block h-10 w-[114px] shrink-0" href="/" aria-label={`${site.name} inicio`}>
          <img
            src="/images/akdemia-menu-logo-car.svg"
            alt=""
            width="80"
            height="34"
            class="absolute left-[14.8%] top-[7.38%] h-[85.25%] w-[70.4%]"
          />
          <img
            src="/images/akdemia-menu-logo-wordmark.svg"
            alt={site.name}
            width="61"
            height="9"
            class="absolute left-[22.86%] top-[40.65%] h-[21.95%] w-[53.15%]"
          />
          <img
            src="/images/akdemia-menu-logo-subtitle.svg"
            alt=""
            width="43"
            height="5"
            class="absolute left-[30.56%] top-[64.67%] h-[10.86%] w-[37.44%]"
          />
        </a>
        <span class="h-2.5 w-px shrink-0" aria-hidden="true"></span>
        <p class="text-sm leading-[normal] text-brand-750">{site.location.area} · {site.location.regionShort} · {site.location.country}</p>
        <p class="text-sm leading-[normal] text-brand-750">{site.contact.schedule}</p>
        <a
          href={site.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase"
        >
          WhatsApp {site.contact.phoneInternational}
        </a>
        <a
          href={site.contact.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase"
        >
          {site.contact.instagram.handle}
        </a>
        <span class="h-px w-full shrink-0 bg-brand-750" aria-hidden="true"></span>
        <p class="w-full text-sm font-normal leading-[normal] text-brand-750 md:w-auto">
          &copy; {new Date().getFullYear()} {site.name}. Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>
