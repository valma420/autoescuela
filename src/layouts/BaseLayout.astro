---
/**
 * Layout base del sitio. Define el <head> con SEO y envuelve el contenido.
 */
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;

const footerNavItems = [
  { href: '#servicios', label: 'Clases' },
  { href: '#cobertura', label: 'Zonas' },
  { href: '#profesor', label: 'Instructor' },
  { href: '#licencia', label: 'Licencia' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#191A33" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;700&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} canonical={canonical} />
  </head>
  <body class="bg-brand-950 text-brand-100 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-brand-950"
    >
      Saltar al contenido
    </a>
    <SiteHeader />
    <slot />
    <footer class="h-[259px] overflow-hidden bg-[#0a0e19] py-10 text-brand-100 md:h-[300px]">
      <div class="ak-container flex h-[179px] flex-col items-start justify-between md:h-[220px] md:items-stretch">
        <div class="contents md:flex md:h-[95px] md:w-full md:items-start md:justify-between">
          <a class="ak-focus relative block h-10 w-[114px] shrink-0 md:h-[95px] md:w-[272px]" href="/" aria-label={`${site.name} inicio`}>
            <img
              src="/images/akdemia-menu-logo-car.svg"
              alt=""
              width="191"
              height="81"
              class="absolute left-[14.8%] top-[7.38%] h-[85.25%] w-[70.4%]"
            />
            <img
              src="/images/akdemia-menu-logo-wordmark.svg"
              alt={site.name}
              width="145"
              height="21"
              class="absolute left-[22.86%] top-[40.65%] h-[21.95%] w-[53.15%]"
            />
            <img
              src="/images/akdemia-menu-logo-subtitle.svg"
              alt=""
              width="102"
              height="10"
              class="absolute left-[30.56%] top-[64.67%] h-[10.86%] w-[37.44%]"
            />
          </a>

          <nav class="hidden md:block" aria-label="Navegación del pie">
            <ul class="flex items-center gap-[38px] text-base font-normal leading-[normal] text-accent-400">
              {
                footerNavItems.map((item) => (
                  <li>
                    <a class="ak-focus transition hover:text-brand-50" href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <span class="h-2.5 w-px shrink-0 md:hidden" aria-hidden="true"></span>

        <div class="contents md:flex md:h-[52px] md:w-full md:flex-wrap md:content-center md:items-center md:justify-between md:gap-y-[14px] desktop:h-[19px] desktop:flex-nowrap desktop:content-normal">
          <p class="text-sm leading-[normal] text-brand-750 md:text-base md:font-medium md:leading-[1.2] md:tracking-[0.09em] md:uppercase">
            {site.location.area} · {site.location.regionShort}<span class="md:hidden"> · {site.location.country}</span>
          </p>
          <p class="text-sm leading-[normal] text-brand-750 md:text-base md:font-medium md:leading-[1.2] md:tracking-[0.09em] md:uppercase">{site.contact.schedule}</p>
          <a
            href={site.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase md:text-base md:text-brand-750"
          >
            <span class="md:hidden">WhatsApp </span>{site.contact.phoneInternational}
          </a>
          <a
            href={site.contact.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase md:text-base md:text-brand-750"
          >
            {site.contact.instagram.handle}
          </a>
        </div>

        <span class="h-px w-full shrink-0 bg-brand-750" aria-hidden="true"></span>
        <p class="w-full text-sm font-normal leading-[normal] text-brand-750 md:w-auto md:text-base">
          &copy; {new Date().getFullYear()} {site.name}. Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>
