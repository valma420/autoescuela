---
/**
 * Layout base del sitio. Define el <head> con SEO y envuelve el contenido.
 */
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import VntSignature from '../components/VntSignature.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;

const footerNavItems = [
  { href: '#servicios', label: 'Clases' },
  { href: '#cobertura', label: 'Zonas' },
  { href: '#profesor', label: 'Instructor' },
  { href: '#licencia', label: 'Licencia' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#191A33" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@500;700&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} canonical={canonical} />
  </head>
  <body class="bg-brand-950 text-brand-100 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-brand-950"
    >
      Saltar al contenido
    </a>
    <SiteHeader />
    <slot />
    <footer class="ak-section-frame min-h-[321px] bg-[#0a0e19] text-brand-100 md:min-h-[300px]">
      <div class="footer-content ak-container flex flex-col items-start md:items-stretch md:justify-between">
        <div class="flex flex-col items-start md:min-h-[69.063px] md:w-full md:flex-row md:items-start md:justify-between desktop:min-h-[66px]">
          <a class="ak-logo ak-focus relative h-[41px] w-[97.36px] md:h-[69.063px] md:w-[164px] desktop:h-[66px] desktop:w-[156.726px]" href="/" aria-label={`${site.name} inicio`}>
            <img
              src="/images/akdemia-menu-logo-car.svg"
              alt=""
              width="191"
              height="81"
              class="ak-logo__car"
            />
            <img
              src="/images/akdemia-menu-logo-wordmark.svg"
              alt={site.name}
              width="145"
              height="21"
              class="ak-logo__wordmark"
            />
            <img
              src="/images/akdemia-menu-logo-subtitle.svg"
              alt=""
              width="102"
              height="10"
              class="ak-logo__subtitle"
            />
          </a>

          <nav class="mt-[22px] block w-full md:mt-0 md:min-w-0 md:w-auto" aria-label="Navegación del pie">
            <ul class="flex flex-wrap items-center justify-between gap-y-2 text-sm font-normal leading-[normal] text-accent-400 md:gap-[38px] md:text-base">
              {
                footerNavItems.map((item) => (
                  <li>
                    <a class="ak-focus transition hover:text-brand-50" href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="footer-contact mt-[22px] flex min-h-[73px] w-full flex-col items-start justify-between gap-y-[3.5px] md:mt-0 md:min-h-[52px] md:flex-row md:flex-wrap md:content-center md:items-center md:justify-between md:gap-y-[14px] desktop:min-h-[19px] desktop:content-normal">
          <p class="text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-750 uppercase md:text-base">
            {site.location.area} · {site.location.regionShort}
          </p>
          <p class="text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-750 uppercase md:text-base">{site.contact.schedule}</p>
          <a
            href={site.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-750 uppercase md:text-base"
          >
            {site.contact.phoneInternational}
          </a>
          <a
            href={site.contact.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ak-focus text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-750 uppercase md:text-base"
          >
            {site.contact.instagram.handle}
          </a>
        </div>

        <span class="mt-[26px] h-px w-full shrink-0 bg-brand-750 md:mt-0" aria-hidden="true"></span>
        <div class="footer-credit mt-2 grid w-full grid-cols-1 items-center gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-3 md:mt-0 md:gap-6">
          <p class="text-xs font-normal leading-normal text-brand-750 md:text-base md:leading-[19px]">
            &copy; {new Date().getFullYear()} {site.name}. Todos los derechos reservados.
          </p>
          <VntSignature />
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer-content {
    min-height: 241px;
  }

  .footer-contact > * {
    max-width: 100%;
  }

  .footer-contact > a {
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .footer-content {
      min-height: calc(300px - var(--ak-section-padding) - var(--ak-section-padding));
    }
  }
</style>
