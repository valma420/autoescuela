---
import { hero, site } from '../data/site';

const [titleLead, titleConnector, titleAccent] = hero.title.split(' ');
---

<section id="inicio" class="relative isolate h-[777px] overflow-hidden bg-[linear-gradient(111deg,#191a33_0%,#0a0e19_71%)] md:h-[677px] desktop:h-[717px]">
  <div class="absolute -left-0.5 top-0 -z-30 h-[780px] w-full overflow-hidden md:inset-0 md:h-full">
    <img
      src={site.assets.heroImage}
      alt="Auto de práctica recorriendo un circuito con conos"
      width="1011"
      height="1555"
      loading="eager"
      fetchpriority="high"
      class="absolute left-[-46.67%] top-0 h-[116.92%] w-[155.89%] max-w-none opacity-35 md:left-0 md:top-0 md:h-[171.77%] md:w-full md:object-fill md:opacity-35 desktop:left-[0.02%] desktop:top-[-30.63%] desktop:h-[255.43%] desktop:w-[99.98%]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(25,26,51,0)_0%,rgba(25,26,51,0.35)_45%,rgba(19,20,41,0.97)_100%)] desktop:bg-[linear-gradient(to_top,rgba(25,26,51,0.86)_0%,rgba(25,26,51,0.49)_50%,rgba(25,26,51,0.22)_100%)]"></div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-[346px] md:h-[500px] desktop:inset-0 desktop:h-full">
    <div class="ak-container flex h-full flex-col justify-center gap-4 pb-[34px] md:flex-row md:items-end md:justify-between md:gap-0 md:py-[59px]">
      <div class="flex flex-col items-start gap-4 md:gap-[22px]">
        <p class="inline-flex items-center gap-2 py-[7px] pr-[14px] text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-50 uppercase md:py-0 md:text-base">
          <span class="ak-dot"></span>
          {hero.eyebrow}
        </p>
        <h1
          class="font-display w-full text-[54px] font-bold leading-[0.85] tracking-[-0.03em] text-brand-50 md:max-w-none md:text-[clamp(66px,calc(7.421875vw_+_9px),104px)]"
        >
          <span class="block">{titleLead}</span>
          <span class="block"><span class="md:text-accent-400">{titleConnector}</span> <span class="text-accent-400">{titleAccent}</span></span>
        </h1>
        <p class="w-full max-w-xl text-base leading-6 text-brand-100 md:w-[clamp(315px,calc(37.3046875vw_+_28.5px),506px)] md:text-xl md:leading-[1.5]">
          {hero.subtitle}
        </p>
      </div>
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-focus inline-flex min-h-[51px] w-full items-center justify-center rounded-full bg-accent-400 px-7 text-sm font-medium tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 md:h-[62px] md:min-h-0 md:w-auto md:flex-none md:px-[38px] md:py-[19px] md:text-xl md:leading-[1.2] desktop:w-[315px]"
      >
        {hero.primaryCta}
      </a>
    </div>
  </div>
</section>
