---
import { hero, site } from '../data/site';

const [titleLead, titleConnector, titleAccent] = hero.title.split(' ');
---

<section id="inicio" class="hero-section relative isolate overflow-hidden bg-[linear-gradient(111deg,#191a33_0%,#0a0e19_71%)]">
  <div class="absolute -left-0.5 top-0 -z-30 h-full w-full overflow-hidden md:inset-0">
    <img
      src={site.assets.heroImage}
      alt="Auto de práctica recorriendo un circuito con conos"
      width="1011"
      height="1555"
      loading="eager"
      fetchpriority="high"
      class="hero-image absolute inset-0 h-full w-full max-w-none object-cover opacity-35"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(25,26,51,0)_0%,rgba(25,26,51,0.35)_45%,rgba(19,20,41,0.97)_100%)] md:bg-[linear-gradient(to_top,rgba(25,26,51,0.86)_0%,rgba(25,26,51,0.49)_50%,rgba(25,26,51,0.22)_100%)]"></div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-[346px] md:inset-0 md:h-auto">
    <div class="ak-container flex h-full flex-col justify-center gap-4 py-[30px] md:flex-row md:items-end md:justify-between md:gap-0 md:py-[var(--ak-section-padding)]">
      <div class="flex flex-col items-start gap-4 md:min-w-0 md:flex-1 md:gap-[22px] desktop:mr-[-217px] desktop:w-[1022px] desktop:flex-none">
        <p class="inline-flex items-center gap-2 py-[7px] pr-[14px] text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-50 uppercase md:py-0 md:text-base">
          <span class="ak-dot"></span>
          {hero.eyebrow}
        </p>
        <h1
          class="ak-hero-title font-display w-full font-bold leading-[0.85] tracking-[-0.03em] text-brand-50 md:max-w-none desktop:w-[1022px]"
        >
          <span class="block">{titleLead}</span>
          <span class="block"><span class="md:text-accent-400">{titleConnector}</span> <span class="text-accent-400">{titleAccent}</span></span>
        </h1>
        <p class="ak-body-large w-full max-w-xl leading-[1.5] text-brand-100 md:w-[clamp(315px,calc(37.3046875vw_+_28.5px),506px)]">
          {hero.subtitle}
        </p>
      </div>
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-primary-cta ak-focus inline-flex w-full items-center justify-center rounded-full bg-accent-400 px-7 font-medium leading-[1.2] tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 md:w-[315px] md:flex-none md:px-[38px] md:py-[19px]"
      >
        {hero.primaryCta}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-image {
    object-position: 58% center;
  }

  .hero-section {
    height: 100vh;
    height: 100svh;
    height: 100dvh;
  }

  @media (min-width: 768px) {
    .hero-image {
      object-position: center 8%;
    }

    .hero-section {
      height: calc(100vh - 84px);
      height: calc(100svh - 84px);
      height: calc(100dvh - 84px);
    }
  }

  @media (min-width: 1280px) {
    .hero-image {
      object-position: center 18%;
    }
  }
</style>
