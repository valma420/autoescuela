---
import { hero, site } from '../data/site';

const [titleLead, titleConnector, titleAccent] = hero.title.split(' ');
---

<section class="relative isolate h-[777px] overflow-hidden bg-[linear-gradient(111deg,#191a33_0%,#0a0e19_71%)] md:h-[820px] desktop:h-[715px]">
  <div class="absolute -left-0.5 top-[50px] -z-30 h-[780px] w-full overflow-hidden md:inset-0 md:h-full">
    <img
      src={site.assets.heroImage}
      alt="Auto de práctica recorriendo un circuito con conos"
      width="1011"
      height="1555"
      loading="eager"
      fetchpriority="high"
      class="absolute left-[-46.67%] top-0 h-[116.92%] w-[155.89%] max-w-none opacity-35 md:left-0 md:h-full md:w-full md:object-cover md:object-top md:opacity-55 desktop:left-[0.02%] desktop:top-[-30.63%] desktop:h-[255.43%] desktop:w-[99.98%] desktop:object-fill desktop:opacity-35"
    />
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(25,26,51,0)_0%,rgba(25,26,51,0.35)_45%,rgba(19,20,41,0.97)_100%)] desktop:bg-[linear-gradient(to_top,rgba(25,26,51,0.86)_0%,rgba(25,26,51,0.49)_50%,rgba(25,26,51,0.22)_100%)]"></div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-[346px] md:h-[500px] desktop:inset-0 desktop:h-full">
    <div class="mx-auto flex h-full w-full max-w-[72rem] flex-col justify-center gap-4 px-[22px] pb-[34px] md:items-start md:justify-end md:px-8 md:pb-20 desktop:max-w-none desktop:flex-row desktop:items-end desktop:justify-between desktop:gap-0 desktop:px-[63px] desktop:py-[59px]">
      <div class="flex flex-col items-start gap-4 desktop:gap-[22px]">
        <p class="inline-flex items-center gap-2 py-[7px] pr-[14px] text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-50 uppercase desktop:py-0 desktop:text-base">
          <span class="ak-dot"></span>
          {hero.eyebrow}
        </p>
        <h1
          class="font-display w-full text-[54px] font-bold leading-[0.85] tracking-[-0.03em] text-brand-50 md:max-w-[10ch] md:text-8xl desktop:max-w-none desktop:text-[104px]"
        >
          <span class="block">{titleLead}</span>
          <span class="block"><span class="desktop:text-accent-400">{titleConnector}</span> <span class="text-accent-400">{titleAccent}</span></span>
        </h1>
        <p class="w-full max-w-xl text-base leading-6 text-brand-100 md:text-lg md:leading-8 desktop:w-[506px] desktop:text-xl desktop:leading-[1.5]">
          {hero.subtitle}
        </p>
      </div>
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-focus inline-flex min-h-[51px] w-full items-center justify-center rounded-full bg-accent-400 px-7 text-sm font-medium tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 md:w-auto desktop:h-[62px] desktop:min-h-0 desktop:w-[315px] desktop:flex-none desktop:px-[38px] desktop:py-[19px] desktop:text-xl desktop:leading-[1.2]"
      >
        {hero.primaryCta}
      </a>
    </div>
  </div>
</section>
