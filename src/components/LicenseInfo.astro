---
import { licenseInfo } from '../data/site';

const [licenseDescriptionLead, licenseDescriptionEnd] = licenseInfo.description.split('. ');
---

<section id="licencia" class="ak-section-frame bg-brand-100 text-[#0a0e19]">
  <div class="ak-container">
    <div>
      <div>
        <h2 class="ak-section-title font-display font-medium leading-none tracking-[-0.03em]">
          {licenseInfo.title}
        </h2>
        <p class="ak-body-large mt-[18px] h-12 max-w-md leading-[1.5] text-[#0a0e19] md:mt-[21px] md:h-[60px] md:w-[312px]">
          <span class="block">{licenseDescriptionLead}.</span>
          <span class="block">{licenseDescriptionEnd}</span>
        </p>
      </div>

      <ul class="mt-[18px] grid h-[484px] grid-rows-[125px_125px_125px_109px] md:mt-[21px] md:h-[239px] md:grid-cols-2 md:grid-rows-[94px_95px] md:gap-x-5 md:gap-y-[30px] md:py-[9px] desktop:h-[224px] desktop:grid-cols-[391px_391px] desktop:grid-rows-[94px_95px] desktop:gap-x-0 desktop:gap-y-[35px] desktop:py-0 desktop:pl-[338px]">
        {
          licenseInfo.items.map((item, index) => (
            <li
              class:list={[
                'flex h-full flex-col gap-2 overflow-hidden rounded-[16px] bg-brand-100 p-5 md:min-h-0 md:self-start md:justify-between md:gap-0 md:rounded-none md:bg-transparent md:p-0',
                index === 0 && 'desktop:h-[94px]',
                index === 1 && 'desktop:h-[94px]',
                index === 2 && 'desktop:h-[95px]',
                index === 3 && 'desktop:h-[77px]',
              ]}
            >
              <span class="block h-[3px] w-7 shrink-0 rounded-full bg-accent-400" aria-hidden="true"></span>
              <span class="block h-1.5 w-[13px] shrink-0" aria-hidden="true"></span>
              <h3 class="font-display text-[clamp(1.25rem,calc(0.9921rem+1.0582vw),1.5rem)] font-medium leading-[1.02] tracking-[-0.03em] text-[#0a0e19]">{item.title}</h3>
              <p
                class:list={[
                  'ak-body-small leading-[normal] text-[#0a0e19] md:w-full',
                  index === 0 && 'w-[253px] desktop:w-[291px]',
                  index === 1 && 'desktop:w-[342px]',
                  index === 2 && 'w-[243px] desktop:w-[219px]',
                ]}
              >
                {item.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
