---
import { coverage, site } from '../data/site';
---

<section id="cobertura" class="ak-section-frame bg-brand-950 text-brand-50" data-coverage-section>
  <div class="ak-container">
    <div class="grid gap-y-6 desktop:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] desktop:items-center desktop:gap-x-16">
      <div class="contents desktop:flex desktop:flex-col desktop:items-start desktop:gap-6">
        <div class="order-1">
          <h2 class="ak-section-title font-display font-medium leading-none tracking-[-0.03em]">
            {coverage.title}
          </h2>
          <p class="ak-body-large mt-[15px] max-w-[34rem] leading-[1.5] text-brand-100 desktop:max-w-[25rem]">
            {coverage.description}
          </p>
        </div>

        <ul class="ak-body-small order-3 flex flex-wrap gap-x-3 gap-y-2 font-normal leading-[1.35] text-brand-100" aria-label="Barrios donde se dictan clases">
          {
            coverage.areas.map((area) => (
              <li class="inline-flex items-center gap-2">
                <span class="ak-dot" aria-hidden="true"></span>
                {area}
              </li>
            ))
          }
        </ul>

        <a
          class="ak-focus order-4 inline-flex min-h-12 w-full touch-manipulation items-center justify-center rounded-full bg-accent-400 px-6 text-center text-sm font-medium tracking-[0.02em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 sm:w-fit"
          href={site.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Consultá tu zona por WhatsApp
        </a>
      </div>

      <figure class="order-2 min-w-0 desktop:row-span-1">
        <div
          class="relative isolate h-[340px] overflow-hidden rounded-[24px] border border-white/15 bg-brand-50 shadow-[0_24px_70px_-28px_rgba(0,0,0,0.65)] md:h-[380px] desktop:h-[420px]"
          aria-busy="true"
          data-map-shell
        >
          <div
            class="h-full w-full bg-brand-100"
            role="region"
            aria-label="Mapa interactivo de las zonas donde AKDemia da clases"
            aria-describedby="coverage-map-caption"
            data-coverage-map
          ></div>

          <div class="pointer-events-none absolute top-3 left-3 z-10 inline-flex items-center gap-2 rounded-full border border-white/70 bg-white/92 px-3 py-2 text-xs font-medium tracking-[0.03em] text-brand-950 shadow-[0_8px_24px_rgba(25,26,51,0.12)] backdrop-blur-md md:top-4 md:left-4" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-accent-400"></span>
            {coverage.areas.length} barrios · Zona de clases
          </div>

          <div class="absolute inset-0 z-20 grid place-items-center bg-brand-50 text-center text-sm text-brand-700" role="status" aria-live="polite" data-map-loading>
            <span class="flex flex-col items-center gap-3">
              <span class="h-9 w-9 motion-safe:animate-spin rounded-full border-[3px] border-brand-200 border-t-accent-400" aria-hidden="true"></span>
              Cargando mapa de cobertura…
            </span>
          </div>

          <div class="absolute inset-0 z-30 hidden place-items-center bg-brand-50 p-6 text-center text-brand-950" role="alert" data-map-error>
            <div class="max-w-[22rem]">
              <p class="font-display text-2xl font-medium tracking-[-0.02em]">El mapa no pudo cargar</p>
              <p class="mt-2 text-sm leading-relaxed text-brand-700">Podés reintentarlo o consultarnos directamente si damos clases en tu zona.</p>
              <div class="mt-5 flex flex-col items-stretch gap-2 sm:flex-row sm:justify-center">
                <button type="button" class="ak-focus inline-flex min-h-12 touch-manipulation items-center justify-center rounded-full border border-brand-300 px-5 text-sm font-medium transition hover:bg-brand-100" data-map-retry>
                  Reintentar
                </button>
                <a class="ak-focus inline-flex min-h-12 touch-manipulation items-center justify-center rounded-full bg-accent-400 px-5 text-sm font-medium text-brand-50 transition hover:bg-brand-950" href={site.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
                  Consultar por WhatsApp
                </a>
              </div>
            </div>
          </div>

          <noscript>
            <div class="absolute inset-0 z-40 grid place-items-center bg-brand-50 p-6 text-center text-brand-950">
              <div>
                <p class="font-medium">Activá JavaScript para ver el mapa interactivo.</p>
                <a class="mt-4 inline-flex min-h-12 items-center justify-center rounded-full bg-accent-400 px-5 text-sm font-medium text-brand-50" href={site.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
                  Consultar por WhatsApp
                </a>
              </div>
            </div>
          </noscript>
        </div>

        <figcaption id="coverage-map-caption" class="mt-2 px-1 text-[11px] leading-relaxed text-brand-300">
          Límites barriales según <a class="ak-focus underline decoration-brand-700 underline-offset-2 transition hover:text-brand-50" href="https://data.buenosaires.gob.ar/dataset/barrios" target="_blank" rel="noopener noreferrer">Buenos Aires Data</a>.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const setupCoverageMap = () => {
    const section = document.querySelector<HTMLElement>('[data-coverage-section]');

    if (!section || section.dataset.mapController === 'ready') return;

    const shell = section.querySelector<HTMLElement>('[data-map-shell]');
    const mapElement = section.querySelector<HTMLElement>('[data-coverage-map]');
    const loading = section.querySelector<HTMLElement>('[data-map-loading]');
    const errorState = section.querySelector<HTMLElement>('[data-map-error]');
    const retryButton = section.querySelector<HTMLButtonElement>('[data-map-retry]');

    if (!shell || !mapElement || !loading || !errorState) return;

    section.dataset.mapController = 'ready';

    let mapHandle: import('../scripts/coverage-map').CoverageMapHandle | undefined;
    let initialization: Promise<void> | undefined;

    const setState = (state: 'loading' | 'ready' | 'error') => {
      loading.classList.toggle('hidden', state !== 'loading');
      loading.classList.toggle('grid', state === 'loading');
      errorState.classList.toggle('hidden', state !== 'error');
      errorState.classList.toggle('grid', state === 'error');
      shell.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    };

    const loadMap = () => {
      if (initialization || mapHandle) return initialization;

      setState('loading');
      retryButton?.setAttribute('disabled', '');

      initialization = (async () => {
        try {
          const { initializeCoverageMap } = await import('../scripts/coverage-map');
          mapHandle = await initializeCoverageMap(mapElement);
          setState('ready');
        } catch {
          mapHandle?.destroy();
          mapHandle = undefined;
          mapElement.replaceChildren();
          setState('error');
        } finally {
          retryButton?.removeAttribute('disabled');
          initialization = undefined;
        }
      })();

      return initialization;
    };

    retryButton?.addEventListener('click', () => void loadMap());

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void loadMap();
        },
        { rootMargin: '300px 0px', threshold: 0.01 },
      );

      observer.observe(section);
    } else {
      void loadMap();
    }
  };

  setupCoverageMap();
</script>

<style>
  :global([data-coverage-map] .maplibregl-canvas:focus-visible) {
    outline: 3px solid #009ee2;
    outline-offset: -4px;
  }

  :global([data-coverage-map] .maplibregl-ctrl-top-right) {
    top: 0.25rem;
    right: 0.25rem;
  }

  :global([data-coverage-map] .maplibregl-ctrl-group) {
    overflow: hidden;
    border: 1px solid rgb(25 26 51 / 12%);
    border-radius: 0.875rem;
    box-shadow: 0 10px 28px rgb(25 26 51 / 16%);
  }

  :global([data-coverage-map] .maplibregl-ctrl-group button) {
    width: 44px;
    height: 44px;
  }

  :global([data-coverage-map] .maplibregl-ctrl-attrib) {
    font-family: var(--font-sans);
    font-size: 10px;
  }

  :global([data-coverage-map] .maplibregl-popup-content) {
    min-width: 150px;
    border: 1px solid rgb(25 26 51 / 10%);
    border-radius: 0.875rem;
    padding: 0.875rem 2.25rem 0.875rem 1rem;
    color: #191a33;
    box-shadow: 0 16px 44px rgb(25 26 51 / 22%);
  }

  :global([data-coverage-map] .maplibregl-popup-close-button) {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    font-size: 1.25rem;
  }

  :global([data-coverage-map] .coverage-popup__eyebrow) {
    display: block;
    color: #116186;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global([data-coverage-map] .coverage-popup__name) {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
  }
</style>
