---
import { contactCta, site } from '../data/site';
---

<section id="contacto" class="h-[373px] overflow-hidden bg-brand-950 py-[60px] text-brand-50 md:h-auto md:py-[100px]">
  <div class="ak-container">
    <p class="h-4 text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase md:hidden">
      Empezá hoy
    </p>
    <h2 class="font-display mt-[18px] h-[60px] w-[275px] text-[30px] font-medium leading-none tracking-[-0.03em] sm:h-auto sm:w-auto sm:max-w-3xl sm:text-6xl md:mt-0 md:w-full md:max-w-none md:text-[52px] desktop:w-[1010px]">
      {contactCta.title}
    </h2>
    <p class="mt-[18px] h-[72px] w-[260px] text-base leading-6 text-brand-100 md:mt-5 md:h-[60px] md:w-full md:max-w-none md:text-xl md:leading-[1.5] desktop:w-[463px]">
      {contactCta.description}
    </p>

    <div class="mt-[18px] flex flex-col items-start gap-4 sm:flex-row sm:items-center md:mt-[55px] md:w-full md:justify-center">
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-focus inline-flex min-h-[51px] w-full items-center justify-center rounded-full bg-accent-400 px-8 text-sm font-medium tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 sm:w-auto md:h-[62px] md:min-h-0 md:w-[315px] md:px-[38px] md:py-[19px] md:text-xl md:leading-[1.2]"
      >
        <span class="md:hidden">{contactCta.cta}</span>
        <span class="hidden md:inline">{contactCta.desktopCta}</span>
      </a>
    </div>
  </div>
</section>
