---
import { contactCta, site } from '../data/site';
---

<section id="contacto" class="h-[373px] overflow-hidden bg-brand-950 py-[60px] text-brand-50 md:h-auto md:py-[5.5rem]">
  <div class="ak-container">
    <p class="h-4 text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase">
      Empezá hoy
    </p>
    <h2 class="font-display mt-[18px] h-[60px] w-[275px] text-[30px] font-medium leading-none tracking-[-0.03em] sm:h-auto sm:w-auto sm:max-w-3xl sm:text-6xl">
      {contactCta.title}
    </h2>
    <p class="mt-[18px] h-[72px] w-[260px] text-base leading-6 text-brand-100 md:h-auto md:w-auto md:max-w-xl md:text-lg md:leading-8">
      {contactCta.description}
    </p>

    <div class="mt-[18px] flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-focus inline-flex min-h-[51px] w-full items-center justify-center rounded-full bg-accent-400 px-8 text-sm font-medium tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 sm:w-auto"
      >
        {contactCta.cta}
      </a>
      <p class="hidden text-sm font-semibold text-brand-100/75 sm:block">
        {site.contact.phoneDisplay} · {site.contact.schedule}
      </p>
    </div>
  </div>
</section>
