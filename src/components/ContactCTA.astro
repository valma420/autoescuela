---
import { contactCta, site } from '../data/site';
---

<section id="contacto" class="ak-section-frame bg-brand-950 text-brand-50">
  <div class="ak-container flex flex-col items-center text-center">
    <h2 class="ak-section-title font-display h-[60px] w-[272px] font-medium leading-none tracking-[-0.03em] sm:h-auto sm:w-auto sm:max-w-3xl md:h-[104px] md:w-[492px] desktop:h-[52px] desktop:w-[1010px]">
      {contactCta.title}
    </h2>
    <p class="ak-body-large mt-[18px] h-12 w-[234px] leading-[1.5] text-brand-100 md:mt-5 md:h-[30px] md:w-[514px] desktop:w-[514px]">
      {contactCta.description}
    </p>

    <div class="mt-[18px] flex flex-col items-center gap-4 sm:flex-row sm:items-center md:mt-10 md:w-full md:justify-center desktop:mt-[55px]">
      <a
        href={site.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ak-primary-cta ak-focus inline-flex w-full items-center justify-center rounded-full bg-accent-400 px-8 font-medium leading-[1.2] tracking-[0.01em] text-brand-50 uppercase transition duration-200 hover:bg-brand-50 hover:text-brand-950 sm:w-auto md:w-[315px] md:px-[38px] md:py-[19px]"
      >
        <span class="md:hidden">{contactCta.cta}</span>
        <span class="hidden md:inline">{contactCta.desktopCta}</span>
      </a>
    </div>
  </div>
</section>
