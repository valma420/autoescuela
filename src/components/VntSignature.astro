---
import logoUrl from '../assets/vnt/logo-signature-white.svg?url';
import { developerCredit } from '../data/site';
---

<a
  class="vnt-signature ak-focus"
  href={developerCredit.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={developerCredit.accessibleLabel}
>
  <span lang="en">{developerCredit.label}</span>
  <img src={logoUrl} alt="" width="2150" height="589" loading="lazy" decoding="async" />
</a>

<style>
  @font-face {
    font-family: 'Host Grotesk';
    src: url('../assets/vnt/HostGrotesk-VariableFont_wght.ttf') format('truetype');
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
  }

  .vnt-signature {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-self: end;
    gap: 0.75rem;
    color: var(--color-brand-100);
    font-family: 'Host Grotesk', Arial, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .vnt-signature img {
    width: auto;
    height: 1.75rem;
    opacity: 0.8;
    transition: opacity 180ms ease;
  }

  .vnt-signature:hover,
  .vnt-signature:focus-visible {
    color: var(--color-brand-50);
  }

  .vnt-signature:hover img,
  .vnt-signature:focus-visible img {
    opacity: 1;
  }

  @media (max-width: 767.98px) {
    .vnt-signature {
      gap: 0.5rem;
      font-size: 0.625rem;
    }

    .vnt-signature img {
      height: 1.25rem;
    }
  }
</style>
