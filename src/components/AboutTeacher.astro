---
import { teacher } from '../data/site';
---

<section id="profesor" class="h-[765px] overflow-hidden bg-brand-950 pb-[52px] text-brand-50 md:h-auto md:py-[5.5rem]">
  <div class="ak-container">
    <div class="lg:grid lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-12">
      <div class="relative h-[360px] overflow-hidden rounded-[22px] bg-[linear-gradient(142deg,#191a33_0%,#0a0e19_71%)] lg:h-[520px]">
        <p class="font-display absolute bottom-[21px] right-[18px] rounded-[14px] bg-brand-50 pb-[14px] pl-4 pr-[18px] pt-[13px] text-2xl font-medium leading-none tracking-[-0.01em] text-brand-950 shadow-[0_10px_24px_-4px_rgba(13,15,36,0.35)]">
          Instructor
        </p>
      </div>

      <div class="mt-[22px] lg:mt-0">
        <h2 class="font-display h-[39px] w-full whitespace-nowrap text-[46px] font-bold leading-[0.85] tracking-[-0.03em] sm:h-auto sm:w-auto sm:text-6xl">
          {teacher.name}
        </h2>
        <p class="mt-[22px] h-4 text-[13px] font-medium leading-[1.2] tracking-[0.09em] text-brand-100 uppercase md:h-auto">
          {teacher.role}
        </p>

        <div class="mt-[22px] flex h-[120px] max-w-2xl flex-col text-base leading-6 text-brand-100 md:h-auto md:text-lg md:leading-8">
          {teacher.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <ul class="mt-[22px] flex h-[90px] flex-col items-start justify-between md:h-auto md:flex-row md:flex-wrap md:justify-start md:gap-2">
          {
            teacher.credentials.map((c) => (
              <li class="ak-pill h-8 bg-brand-950 px-3 py-2 text-sm text-brand-100">
                <span class="ak-dot"></span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
