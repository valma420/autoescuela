---
import { hero, services, site } from '../data/site';
---

<section id="servicios" class="ak-section-frame bg-brand-100 text-brand-950">
  <div class="ak-container flex flex-col gap-5 md:gap-[21px]">
    <div class="max-w-2xl desktop:w-full desktop:max-w-none">
      <h2 class="ak-section-title font-display font-medium leading-none tracking-[-0.03em]">
        Clases para cada objetivo
      </h2>
    </div>

    <ul class="service-chip-list flex content-start flex-wrap md:flex-nowrap">
      {
        hero.highlights.map((item, index) => (
          <li
            class="ak-chip inline-flex shrink-0 items-center rounded-full bg-transparent font-normal whitespace-nowrap text-brand-950"
          >
            <span class="ak-dot"></span>
            <span class="md:hidden">{hero.mobileHighlights[index]}</span>
            <span class="hidden md:inline">{item}</span>
          </li>
        ))
      }
    </ul>

    <ul class="service-card-list grid grid-cols-1 gap-3 md:gap-5 desktop:grid-cols-3">
      {
        services.map((service, index) => (
          <li>
            <a
              href={site.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar por ${service.title}`}
              class="service-card ak-focus flex h-full flex-col justify-between overflow-hidden rounded-[18px] bg-brand-50 px-[22px] pb-6 pt-[22px] text-brand-950 shadow-[0_8px_20px_-6px_rgba(26,77,115,0.15)]"
            >
              <div class="flex items-start justify-between">
                <h3 class="font-display text-[clamp(1.5rem,calc(1.2421rem+1.0582vw),1.75rem)] font-medium leading-none tracking-[-0.01em]">{service.title}</h3>
                <span
                  aria-hidden="true"
                  class="service-card__arrow grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-100 text-[17px] font-semibold leading-none text-accent-400 md:text-brand-950"
                >
                  →
                </span>
              </div>
              <p
                class:list={[
                  'service-card__description ak-body-small font-normal leading-[normal] text-brand-750 md:w-full md:text-brand-950',
                  index === 1 ? 'w-[239px]' : 'w-[255px]',
                  index === 0 && 'desktop:w-[237px]',
                  index === 1 && 'desktop:w-[238px]',
                  index === 2 && 'desktop:w-[248px]',
                ]}
              >
                {service.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .service-chip-list {
    min-height: 70px;
    column-gap: 8px;
    row-gap: 2px;
  }

  .service-card {
    min-height: 114px;
    touch-action: manipulation;
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card__description,
  .service-card__arrow {
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card__description {
    line-height: clamp(16px, calc(12.9048px + 0.7937vw), 19px);
  }

  .service-card:is(:focus, :active, .is-pressed) {
    background-color: #191a33;
    color: #f4f8fb;
    box-shadow: none;
  }

  .service-card:is(:focus, :active, .is-pressed) .service-card__description {
    color: #e3f2f7;
  }

  .service-card:is(:focus, :active, .is-pressed) .service-card__arrow {
    background-color: #009ee2;
    color: #f4f8fb;
    transform: translateX(2px);
  }

  .service-card:is(:active, .is-pressed) .service-card__arrow {
    transform: translateX(3px);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      background-color: #191a33;
      color: #f4f8fb;
      box-shadow: none;
    }

    .service-card:hover .service-card__description {
      color: #e3f2f7;
    }

    .service-card:hover .service-card__arrow {
      background-color: #009ee2;
      color: #f4f8fb;
      transform: translateX(2px);
    }
  }

  @media (min-width: 768px) {
    .service-chip-list {
      min-height: 53px;
      column-gap: clamp(4px, calc(-8px + 1.5625vw), 12px);
      row-gap: 0;
    }

    .service-card {
      min-height: 113px;
    }

  }

  @media (min-width: 1280px) {
    .service-chip-list {
      min-height: 50px;
    }

    .service-card {
      min-height: 132px;
    }
  }
</style>

<script>
  const minimumPressDuration = 150;
  const pressStartedAt = new WeakMap<HTMLElement, number>();
  const releaseTimers = new WeakMap<HTMLElement, number>();
  const serviceCards = Array.from(document.querySelectorAll<HTMLElement>('.service-card'));

  const showPressedState = (card: HTMLElement) => {
    const releaseTimer = releaseTimers.get(card);

    if (releaseTimer !== undefined) {
      window.clearTimeout(releaseTimer);
    }

    pressStartedAt.set(card, performance.now());
    card.classList.add('is-pressed');
  };

  const hidePressedState = (card: HTMLElement) => {
    if (!card.classList.contains('is-pressed')) return;

    const pendingRelease = releaseTimers.get(card);

    if (pendingRelease !== undefined) {
      window.clearTimeout(pendingRelease);
    }

    const elapsed = performance.now() - (pressStartedAt.get(card) ?? performance.now());
    const delay = Math.max(0, minimumPressDuration - elapsed);
    const releaseTimer = window.setTimeout(() => {
      card.classList.remove('is-pressed');
      pressStartedAt.delete(card);
      releaseTimers.delete(card);
    }, delay);

    releaseTimers.set(card, releaseTimer);
  };

  serviceCards.forEach((card) => {
    card.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      showPressedState(card);
    });

    card.addEventListener('pointerup', () => hidePressedState(card));
    card.addEventListener('pointercancel', () => hidePressedState(card));
    card.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') hidePressedState(card);
    });
  });
</script>
