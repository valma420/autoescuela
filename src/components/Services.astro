---
import { hero, services, site } from '../data/site';
---

<section id="servicios" class="h-[616px] overflow-hidden bg-brand-100 py-10 text-brand-950 md:h-[606px] md:py-10 desktop:h-[396px] desktop:py-[60px]">
  <div class="ak-container flex flex-col gap-5 md:gap-[21px]">
    <div class="max-w-2xl desktop:w-full desktop:max-w-none">
      <h2 class="font-display text-[30px] font-medium leading-none tracking-[-0.03em] sm:text-5xl md:text-[52px]">
        Clases para cada objetivo
      </h2>
    </div>

    <ul class="flex h-[70px] content-start flex-wrap gap-2 md:h-[53px] md:flex-nowrap md:gap-x-1 md:gap-y-0 desktop:h-[50px] desktop:gap-x-3">
      {
        hero.highlights.map((item, index) => (
          <li
            class:list={[
              'inline-flex h-[34px] shrink-0 items-center gap-2 rounded-full bg-transparent py-[9px] pl-[13px] pr-[15px] text-sm font-normal leading-[normal] whitespace-nowrap text-brand-950 md:h-[50px] md:py-2.5 md:pl-4 md:pr-[18px] md:text-xl md:leading-[1.5]',
              index === 0 && 'w-[146px] md:w-[196px]',
              index === 1 && 'w-[120px] md:w-[159px]',
              index === 2 && 'w-[171px] md:w-[173px]',
              index === 3 && 'w-[112px] md:w-[148px]',
            ]}
          >
            <span class="ak-dot"></span>
            <span class="md:hidden">{hero.mobileHighlights[index]}</span>
            <span class="hidden md:inline">{item}</span>
          </li>
        ))
      }
    </ul>

    <ul class="service-card-list grid h-[366px] grid-rows-[114px_114px_114px] gap-3 md:h-[379px] md:grid-cols-1 md:grid-rows-[113px_113px_113px] md:gap-5 desktop:h-[132px] desktop:grid-cols-3 desktop:grid-rows-1">
      {
        services.map((service, index) => (
          <li class="h-full">
            <a
              href={site.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar por ${service.title}`}
              class:list={[
                'service-card ak-focus flex h-full flex-col justify-between overflow-hidden rounded-[18px] bg-brand-50 px-[22px] pb-6 pt-[22px] text-brand-950 shadow-[0_8px_20px_-6px_rgba(26,77,115,0.15)]',
                index === 0 && 'service-card--featured',
              ]}
            >
              <div class="flex items-start justify-between">
                <h3 class="font-display text-2xl font-medium leading-none tracking-[-0.01em] md:text-[28px]">{service.title}</h3>
                <span
                  aria-hidden="true"
                  class="service-card__arrow grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-100 text-[17px] font-semibold leading-none text-accent-400 md:text-brand-950"
                >
                  →
                </span>
              </div>
              <p
                class:list={[
                  'service-card__description text-sm font-normal leading-[normal] text-brand-750 md:w-full md:text-base md:text-brand-950',
                  index === 1 ? 'w-[239px]' : 'w-[255px]',
                  index === 0 && 'desktop:w-[237px]',
                  index === 1 && 'desktop:w-[238px]',
                  index === 2 && 'desktop:w-[248px]',
                ]}
              >
                {service.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .service-card {
    touch-action: manipulation;
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card__description,
  .service-card__arrow {
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card:is(:focus, :active, .is-pressed) {
    background-color: #191a33;
    color: #f4f8fb;
    box-shadow: none;
  }

  .service-card--featured {
    background-color: #191a33;
    color: #f4f8fb;
    box-shadow: none;
  }

  .service-card--featured .service-card__description {
    color: #e3f2f7;
  }

  .service-card--featured .service-card__arrow {
    background-color: #009ee2;
    color: #f4f8fb;
  }

  .service-card:is(:focus, :active, .is-pressed) .service-card__description {
    color: #e3f2f7;
  }

  .service-card:is(:focus, :active, .is-pressed) .service-card__arrow {
    background-color: #009ee2;
    color: #f4f8fb;
    transform: translateX(2px);
  }

  .service-card:is(:active, .is-pressed) .service-card__arrow {
    transform: translateX(3px);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      background-color: #191a33;
      color: #f4f8fb;
      box-shadow: none;
    }

    .service-card:hover .service-card__description {
      color: #e3f2f7;
    }

    .service-card:hover .service-card__arrow {
      background-color: #009ee2;
      color: #f4f8fb;
      transform: translateX(2px);
    }
  }

  @media (min-width: 768px) {
    .service-card-list:not(:has(.service-card:is(:hover, :focus, :active, .is-pressed))) .service-card.is-pointer-current {
      background-color: #191a33;
      color: #f4f8fb;
      box-shadow: none;
    }

    .service-card-list:not(:has(.service-card:is(:hover, :focus, :active, .is-pressed))) .service-card.is-pointer-current .service-card__description {
      color: #e3f2f7;
    }

    .service-card-list:not(:has(.service-card:is(:hover, :focus, :active, .is-pressed))) .service-card.is-pointer-current .service-card__arrow {
      background-color: #009ee2;
      color: #f4f8fb;
      transform: translateX(2px);
    }
  }
</style>

<script>
  const minimumPressDuration = 150;
  const pressStartedAt = new WeakMap<HTMLElement, number>();
  const releaseTimers = new WeakMap<HTMLElement, number>();
  const serviceCards = Array.from(document.querySelectorAll<HTMLElement>('.service-card'));
  const desktopPointer = window.matchMedia('(min-width: 1200px) and (hover: hover) and (pointer: fine)');

  const showPressedState = (card: HTMLElement) => {
    const releaseTimer = releaseTimers.get(card);

    if (releaseTimer !== undefined) {
      window.clearTimeout(releaseTimer);
    }

    pressStartedAt.set(card, performance.now());
    card.classList.add('is-pressed');
  };

  const hidePressedState = (card: HTMLElement) => {
    if (!card.classList.contains('is-pressed')) return;

    const pendingRelease = releaseTimers.get(card);

    if (pendingRelease !== undefined) {
      window.clearTimeout(pendingRelease);
    }

    const elapsed = performance.now() - (pressStartedAt.get(card) ?? performance.now());
    const delay = Math.max(0, minimumPressDuration - elapsed);
    const releaseTimer = window.setTimeout(() => {
      card.classList.remove('is-pressed');
      pressStartedAt.delete(card);
      releaseTimers.delete(card);
    }, delay);

    releaseTimers.set(card, releaseTimer);
  };

  serviceCards.forEach((card) => {
    card.addEventListener('pointerenter', (event) => {
      if (!desktopPointer.matches || event.pointerType === 'touch') return;

      serviceCards.forEach((candidate) => {
        candidate.classList.toggle('is-pointer-current', candidate === card);
      });
    });

    card.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      showPressedState(card);
    });

    card.addEventListener('pointerup', () => hidePressedState(card));
    card.addEventListener('pointercancel', () => hidePressedState(card));
    card.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') hidePressedState(card);
    });
  });
</script>
