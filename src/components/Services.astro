---
import { hero, services, site } from '../data/site';
---

<section id="servicios" class="h-[896px] overflow-hidden bg-brand-100 py-14 text-brand-950 md:h-auto md:py-[5.5rem]">
  <div class="ak-container">
    <div class="max-w-2xl">
      <h2 class="font-display text-[30px] font-medium leading-none tracking-[-0.03em] sm:text-5xl">
        Clases prácticas
      </h2>
      <p class="mt-[14px] max-w-xl text-base leading-6 text-brand-750 md:text-lg">
        Cada clase apunta a una meta concreta: arrancar de cero, ganar calle o
        practicar para el examen de CABA.
      </p>
    </div>

    <ul class="mt-5 flex h-[76px] content-start flex-wrap gap-2 md:h-auto">
      {
        hero.highlights.map((item) => (
          <li class="inline-flex h-[34px] items-center gap-2 rounded-full bg-brand-50 py-[9px] pl-[13px] pr-[15px] text-sm font-normal leading-none text-brand-950">
            <span class="ak-dot"></span>
            {item}
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 grid h-[552px] gap-3 md:h-auto md:grid-cols-2">
      {
        services.map((service, index) => (
          <li
            class:list={[
              'flex h-[126px] flex-col justify-between rounded-[18px] px-[22px] pb-6 pt-[22px] shadow-[0_8px_20px_-6px_rgba(26,77,115,0.15)] transition duration-200 hover:-translate-y-0.5 md:h-auto md:min-h-[160px]',
              index === 2 && 'h-[138px]',
              index === 0
                ? 'bg-brand-950 text-brand-50'
                : 'bg-brand-50 text-brand-950',
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-display text-2xl font-medium leading-none tracking-[-0.01em]">{service.title}</h3>
              <a
                href={site.contact.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Consultar por ${service.title}`}
                class:list={[
                  'ak-focus grid h-9 w-9 shrink-0 place-items-center rounded-full text-[17px] font-semibold leading-none transition',
                  index === 0
                    ? 'bg-accent-400 text-brand-50 hover:bg-brand-50 hover:text-brand-950'
                    : 'bg-brand-100 text-accent-400 hover:bg-accent-400 hover:text-brand-50',
                ]}
              >
                →
              </a>
            </div>
            <p
              class:list={[
                'text-sm font-normal leading-none',
                index === 0 ? 'text-brand-100' : 'text-brand-800/75',
              ]}
            >
              {service.description}
            </p>
          </li>
        ))
      }
    </ul>

  </div>
</section>
