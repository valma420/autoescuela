---
import { hero, services, site } from '../data/site';
---

<section id="servicios" class="h-[640px] overflow-hidden bg-brand-100 py-14 text-brand-950 md:h-auto md:py-[5.5rem]">
  <div class="ak-container flex flex-col gap-5">
    <div class="max-w-2xl">
      <h2 class="font-display text-[30px] font-medium leading-none tracking-[-0.03em] sm:text-5xl">
        Clases para cada objetivo
      </h2>
    </div>

    <ul class="flex h-[76px] content-start flex-wrap gap-2 md:h-auto">
      {
        hero.highlights.map((item) => (
          <li class="inline-flex h-[34px] items-center gap-2 rounded-full bg-brand-50 py-[9px] pl-[13px] pr-[15px] text-sm font-normal leading-[normal] text-brand-950">
            <span class="ak-dot"></span>
            {item}
          </li>
        ))
      }
    </ul>

    <ul class="grid h-[382px] grid-rows-[114px_114px_130px] gap-3 md:h-auto md:grid-cols-2 md:grid-rows-none">
      {
        services.map((service, index) => (
          <li class="h-full md:min-h-[160px]">
            <a
              href={site.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar por ${service.title}`}
              class="service-card ak-focus flex h-full flex-col justify-between overflow-hidden rounded-[18px] bg-brand-50 px-[22px] pb-6 pt-[22px] text-brand-950 shadow-[0_8px_20px_-6px_rgba(26,77,115,0.15)]"
            >
              <div class="flex items-start justify-between">
                <h3 class="font-display text-2xl font-medium leading-none tracking-[-0.01em]">{service.title}</h3>
                <span
                  aria-hidden="true"
                  class="service-card__arrow grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-100 text-[17px] font-semibold leading-none text-accent-400"
                >
                  →
                </span>
              </div>
              <p
                class:list={[
                  'service-card__description text-sm font-normal leading-[normal] text-brand-750',
                  index === 1 ? 'w-[239px]' : 'w-[255px]',
                ]}
              >
                {service.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .service-card {
    touch-action: manipulation;
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card__description,
  .service-card__arrow {
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card:is(:focus, :active) {
    background-color: #191a33;
    color: #f4f8fb;
    box-shadow: none;
  }

  .service-card:is(:focus, :active) .service-card__description {
    color: #e3f2f7;
  }

  .service-card:is(:focus, :active) .service-card__arrow {
    background-color: #009ee2;
    color: #f4f8fb;
    transform: translateX(2px);
  }

  .service-card:active .service-card__arrow {
    transform: translateX(3px);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      background-color: #191a33;
      color: #f4f8fb;
      box-shadow: none;
    }

    .service-card:hover .service-card__description {
      color: #e3f2f7;
    }

    .service-card:hover .service-card__arrow {
      background-color: #009ee2;
      color: #f4f8fb;
      transform: translateX(2px);
    }
  }
</style>
